{
  "name": "atlas-rail-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Spending rules and verifiable receipts for AI agents paying on Solana (devnet)",
  "license": "Apache-2.0",
  "author": "Atlas Rail Contributors",
  "scripts": {
    "demo": "node scripts/demo-story.mjs",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts packages/domain packages/solana",
    "test:integration": "vitest run --config vitest.config.ts apps/api",
    "test:chain": "node --test --test-force-exit scripts/topup-local.test.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @atlas-rail/database db:generate",
    "db:migrate": "pnpm --filter @atlas-rail/database db:migrate",
    "db:seed": "pnpm --filter @atlas-rail/database db:seed",
    "db:push": "pnpm --filter @atlas-rail/database db:push",
    "openapi": "pnpm --filter @atlas-rail/api openapi",
    "demo:pay": "node scripts/demo-pay.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "lodash": ">=4.18.0",
      "js-yaml@4": ">=4.3.2",
      "ajv@8": ">=8.18.0",
      "qs@6": ">=6.16.0",
      "glob@10": ">=10.5.0",
      "picomatch@4": ">=4.0.4",
      "webpack@5": ">=5.104.1",
      "esbuild": ">=0.25.0",
      "proxy-addr@2": "^2.0.8",
      "fast-uri@2": "^2.4.6",
      "fast-uri@3": "^3.1.7",
      "undici@6": "^6.29.1",
      "body-parser@1": "^1.20.9",
      "body-parser@2": "^2.4.0",
      "sharp@0": "^0.35.5",
      "source-map-js@1": "^1.2.2",
      "zod@4": "^4.6.6",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@2": "^2.1.6",
      "brace-expansion@5": "^5.0.11"
    }
  }
}

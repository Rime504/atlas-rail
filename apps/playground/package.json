{
  "name": "@atlas-rail/playground",
  "version": "0.1.0",
  "private": true,
  "description": "Public, no-login walkthrough of Atlas Rail's policy gate, built on the real gate and receipt code. Deployable to Vercel independently of the console.",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "clean": "rimraf .next dist tsconfig.tsbuildinfo",
    "publish-showcase": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/publish-showcase.mts"
  },
  "dependencies": {
    "@atlas-rail/mandate": "workspace:*",
    "@atlas-rail/receipt": "workspace:*",
    "@atlas-rail/solana": "workspace:*",
    "@solana/web3.js": "^1.95.8",
    "@vercel/blob": "^2.8.1",
    "lucide-react": "^0.468.0",
    "next": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@atlas-rail/typescript-config": "workspace:*",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  }
}

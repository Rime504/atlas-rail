# Devnet mode (optional). Without these, the playground silently runs in instant mode only —
# that's the correct behavior, not a misconfiguration.
#
# Must be a FUNDED devnet keypair (base58 secret key, Solana CLI format: 64 bytes, or a 32-byte
# seed). It pays the rent for create_mandate/revoke_mandate on the deployed program
# (CnGoTE5Bxc8MFGaeK5LDv5uAZ7pNiktMunYy8JZcLY4k). Never commit a real value here.
PLAYGROUND_DEVNET_OWNER_SECRET_KEY=

# Optional overrides. If unset, the server generates these once and reuses them for its lifetime —
# they only ever need to sign, never to hold SOL, so there's no reason to fund them.
# PLAYGROUND_DEVNET_APPROVER_SECRET_KEY=
# PLAYGROUND_DEVNET_AGENT_SECRET_KEY=
# PLAYGROUND_DEVNET_INSTANCE_SECRET_KEY=

# Optional overrides, default to the production values.
# MANDATE_PROGRAM_ID=CnGoTE5Bxc8MFGaeK5LDv5uAZ7pNiktMunYy8JZcLY4k
# PLAYGROUND_SOLANA_RPC_URL=https://api.devnet.solana.com

{
  "name": "@atlas-rail/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc --build",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "db:migrate:dev": "prisma migrate dev"
  },
  "prisma": {
    "seed": "node -r ts-node/register prisma/seed.ts"
  },
  "dependencies": {
    "@atlas-rail/mandate": "workspace:*",
    "@atlas-rail/receipt": "workspace:*",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@atlas-rail/typescript-config": "workspace:*",
    "@types/node": "^22.10.1",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}

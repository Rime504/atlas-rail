# System Environment
NODE_ENV=development
LOG_LEVEL=debug

# Database Configuration
DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas_rail?schema=public"
REDIS_URL="redis://localhost:6379"

# API & Web Server Ports and Base URLs
API_PORT=3001
WEB_PORT=3000
API_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"

# JWT Authentication Secrets (Generate secure 32+ byte strings in production)
JWT_ACCESS_SECRET="atlas_rail_dev_access_secret_do_not_use_in_production_32bytes"
JWT_REFRESH_SECRET="atlas_rail_dev_refresh_secret_do_not_use_in_production_32bytes"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Webhook Secret Encryption Key (Must be 32-byte base64 encoded string)
ENCRYPTION_KEY_BASE64="c29tZV9zZWNyZXRfMzJfYnl0ZV9rZXlfZm9yX2RldnZ2"

# Solana Devnet Configuration
SOLANA_CLUSTER="devnet"
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_USDC_MINT="4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"
SOLANA_COMMITMENT="confirmed"
SOLANA_EXPLORER_CLUSTER="devnet"

# Safety Flags
ATLAS_ALLOW_MOCK_SIGNER=true
ATLAS_EXTERNAL_SIGNER_ENABLED=false
ATLAS_MAINNET_ENABLED=false

# Webhook Delivery Settings
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_MS=10000

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_PAYOUT_CREATE_PER_MINUTE=20

# Seeding & Demo Data
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL="admin@atlasrail.local"
DEMO_ADMIN_PASSWORD="ChangeMe_AtlasRail_DevOnly"

# Agent Mandates (see docs/DEMO.md) — devnet only, all optional with safe defaults
# Where the API and worker keep the devnet instance/user signing keys. Never committed;
# refuses to load outside ATLAS_ALLOW_MOCK_SIGNER=true / non-production.
ATLAS_KEYRING_PATH=".demo/keyring.json"
# Require a successful pre-flight simulation of the exact transaction before ALLOW. Only
# set to "false" for isolated unit testing of the gate; leave "true" everywhere else.
AGENT_REQUIRE_SIMULATION=true
# How often the worker batches unanchored receipts and writes the Merkle root to devnet.
AGENT_ANCHOR_INTERVAL_MS=300000

# `pnpm demo` / `pnpm demo:offline` only — the orchestrator sets these itself; you do not
# need to set them by hand unless you are running the demo services individually.
# DEMO_MODE=mock              # "mock" (in-memory Solana JSON-RPC) or "devnet" (real devnet + faucet)
# DEMO_ASSET=demo-mint        # "demo-mint" (self-minted) or "circle-usdc" (needs faucet.circle.com funds)
# DEMO_FUNDER_SECRET_KEY=     # optional base58 secret key to skip the devnet airdrop faucet
# DEMO_API_URL="http://localhost:4402"
# FACILITATOR_URL="http://127.0.0.1:4022"
# ATLAS_API_URL="http://localhost:3001"
# ATLAS_WEB_URL="http://localhost:3000"

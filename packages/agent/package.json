{
  "name": "@atlas-rail/agent",
  "version": "0.1.0",
  "description": "Give an AI agent a payment-capable fetch that can only pay what its signed Atlas Rail mandate allows.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@atlas-rail/mandate": "workspace:*",
    "@atlas-rail/solana": "workspace:*",
    "@atlas-rail/x402": "workspace:*"
  },
  "devDependencies": {
    "@atlas-rail/receipt": "workspace:*",
    "@atlas-rail/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rime504/atlas-rail.git",
    "directory": "packages/agent"
  },
  "publishConfig": {
    "access": "public"
  }
}

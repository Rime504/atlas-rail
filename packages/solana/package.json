{
  "name": "@atlas-rail/solana",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@atlas-rail/config": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@scure/base": "^1.2.6",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8"
  },
  "devDependencies": {
    "@atlas-rail/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "testing.d.ts",
    "testing.js",
    "!dist/**/*.test.*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rime504/atlas-rail.git",
    "directory": "packages/solana"
  },
  "publishConfig": {
    "access": "public"
  }
}

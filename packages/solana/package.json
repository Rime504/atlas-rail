  },
  "devDependencies": {
    "@atlas-rail/typescript-config": "workspace:*",
    "@types/node": "^22.20.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "files": [
    "testing.d.ts",
    "testing.js"
  ]
